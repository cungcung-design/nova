# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nova_db"

# NextAuth (use the same value for both)
NEXTAUTH_SECRET="generate-a-long-random-string"
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Redis for shared rate limiting across instances.
# Leave empty to use in-process memory.
# Docker Compose: redis://redis:6379
REDIS_URL=

# Optional email for password reset and team invitations (Resend).
# If unset, emails are logged to the server console.
RESEND_API_KEY=
MAIL_FROM="NOVA <noreply@localhost>"

# Stripe (browser-safe publishable key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe (server-only)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
STRIPE_BUSINESS_YEARLY_PRICE_ID=""

# Payment provider (aliases; Stripe values are used as fallback)
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_PRO_PRICE_ID=""
PAYMENT_BUSINESS_PRICE_ID=""
PAYMENT_PRO_MONTHLY_PRICE_ID=""
PAYMENT_PRO_YEARLY_PRICE_ID=""
PAYMENT_BUSINESS_MONTHLY_PRICE_ID=""
PAYMENT_BUSINESS_YEARLY_PRICE_ID=""

# Docker Compose production example:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/nova_db"
# REDIS_URL="redis://redis:6379"
# NEXTAUTH_URL="https://your-domain.example"
# NEXT_PUBLIC_APP_URL="https://your-domain.example"
